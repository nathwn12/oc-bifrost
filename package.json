{
  "name": "@nathwn12/oc-bifrost",
  "version": "0.1.0",
  "description": "The rainbow bridge for OpenCode plugins — run V1-era plugin hooks on the OpenCode V2 runtime, seamlessly.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "compatibility",
    "v1",
    "v2",
    "adapter",
    "bridge"
  ],
  "license": "MIT",
  "author": "nathwn12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathwn12/oc-bifrost.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.js",
    "check": "npm run typecheck && npm run build && npm run test"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.18",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
